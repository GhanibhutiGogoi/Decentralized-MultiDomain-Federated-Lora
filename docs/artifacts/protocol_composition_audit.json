{
  "schema_version": 2,
  "title": "Protocol composition audit",
  "conclusion": "The historical composed comparison was invalid: Sinkhorn canceled domain factors, a median-loss rule replaced P1, pooled scaling differed, and final assembly was centralized. The corrected experiment executes P1/P2, weighted MH and neighbor-tree assembly; accuracy preservation is not achieved under the tested 30-round frozen-feature protocol.",
  "findings": [
    {
      "id": "rank-controller-not-composed",
      "claim": "P1 adaptive rank is not invoked by P3",
      "evidence": [
        "P1 controller appears in project-1-adaptive-rank/experiment/exp1.py",
        "P3 protocol_benchmark.py constructs ranks from config.ranks and passes fixed target_ranks to DecentralizedRunner"
      ]
    },
    {
      "id": "domain-weight-not-composed",
      "claim": "P2 conservative domain factors are optional API inputs and are not passed by P2 Experiment 1 or P3",
      "evidence": [
        "fedavg_quality_weighted accepts domain_features=None",
        "P2 Experiment 1 calls aggregate_fn without domain_features/lambda_weights",
        "P3 uses DecentralizedRunner gossip, not P2 fedavg_quality_weighted"
      ]
    },
    {
      "id": "objective-mismatch",
      "claim": "P1 accuracy, P2 leave-one-out contribution ranking, and P3 personalized/consensus accuracy are different targets",
      "evidence": [
        "P1 reports task accuracy",
        "P2 target is delta_accuracy",
        "P3 reports personalized_accuracy and consensus_accuracy"
      ]
    },
    {
      "id": "heterogeneous-rank-cost",
      "claim": "P3 heterogeneous 4/12/32 schedule introduces receiver-side SVD truncation each round; rank-4 clients can discard mixed update energy",
      "evidence": [
        "runner computes factorize_delta(y,target_rank) per receiver",
        "existing P3 artifacts show heterogeneous \u0394W FedAvg 5.74% personalized vs uniform-rank \u0394W FedAvg 23.20%"
      ]
    }
  ],
  "required_matched_ablation": {
    "fixed_factors": [
      "same split",
      "same seed",
      "same rounds",
      "same initialization",
      "same graph",
      "same alpha/lr",
      "same rank budget",
      "same evaluation target"
    ],
    "arms": [
      "fixed feasible ranks vs adaptive controller in P3 runner",
      "quality-only aggregation vs conservative domain factors in same decentralized graph",
      "uniform rank 16 vs heterogeneous 4/12/32"
    ],
    "interpretation": "Only this matrix can attribute an end-to-end gain or failure to rank adaptation or domain weighting."
  },
