  "scope": {
    "required": [
      "Protocol-correct benchmark using frozen ResNet-18 features and LoRA on the final classification layer",
      "15 clients across 5 known CIFAR-100 domain groups with Dirichlet non-IID training partitions",
      "Local-only, centralized delta-W FedAvg, flat Metropolis-Hastings gossip and oracle two-tier gossip",
      "Both personalized and full-test consensus evaluation",
      "Three-seed experiment outputs, per-domain fairness, communication and compression diagnostics",
      "Heterogeneous-rank comparison of delta-W merging and factor zero-padding",
      "Reviewable pull requests and a machine-readable evidence handoff"
    ],
    "extensions": [
      "Error-feedback versus default compression experiment",
      "Direction-aware signatures and automatic domain discovery",
      "Project 2 real-data regeneration and lambda recalibration",
      "Project 1 rank-policy calibration",
      "A publication manuscript"
    ],
    "explicit_assumptions": [
      "Oracle hierarchical gossip receives known domain labels",
      "Cached features use a fixed frozen backbone protocol documented in each run manifest",
      "This is a single image-classification benchmark; results do not establish behavior on LLMs or all data domains"
    ]
  },
